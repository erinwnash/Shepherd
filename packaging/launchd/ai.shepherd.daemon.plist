<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.shepherd.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/shepherd</string>
        <string>start</string>
        <string>-f</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>~/Library/Logs/shepherd.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/shepherd.err.log</string>
</dict>
</plist>
